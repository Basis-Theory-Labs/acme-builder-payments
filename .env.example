# App
APP_URL=http://localhost:3000
DB_PATH=data/app.db

# Basis Theory (test tenant). Create two applications in the portal:
#   Public:  token:create
#   Private: token:create, token:read, proxy:invoke, keys:create,
#            network-token:create, network-token:read, network-token:reveal, network-token:cryptogram
BT_API_URL=https://api.basistheory.com
NEXT_PUBLIC_BT_PUBLIC_API_KEY=
BT_PRIVATE_API_KEY=
# Optional: a separate private app with only token:create for the Stripe forward. Defaults to BT_PRIVATE_API_KEY.
BT_FORWARD_API_KEY=

# Stripe (test mode, raw card data APIs enabled)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: only for `yarn stripe:listen:phase-1` (renewal webhooks)
STRIPE_WEBHOOK_SECRET=

# Checkout.com (sandbox)
CKO_API_URL=https://api.sandbox.checkout.com
CKO_SECRET_KEY=
CKO_PROCESSING_CHANNEL_ID=

# Behaviour switches (also editable at runtime on /ops)
SIMULATE_BT_DOWN=false
SIMULATE_STRIPE_DOWN=false
PHASE1_ROLLOUT_PERCENT=0        # 0-100, by workspace id hash
PHASE1_COUNTRIES=BR             # comma separated, always Phase 1
PHASE1_RENEWALS=orchestrated    # orchestrated | stripe-native

PHASE1_CARD_WRITE=dual-write      # dual-write | proxy
