    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "next": "16.4.6",
    "picocolors": "1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "jose": "6.2.15",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
